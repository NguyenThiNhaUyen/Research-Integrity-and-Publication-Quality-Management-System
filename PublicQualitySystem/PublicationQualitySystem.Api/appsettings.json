{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=PublicationQualityDB;Username=postgres;Password=123456"
  },
  "Aws": {
    "AccessKey": "${AWS_ACCESS_KEY}",
    "SecretKey": "${AWS_SECRET_KEY}",
    "Region": "${AWS_REGION}",
    "ExpectedCallerArn": "${AWS_EXPECTED_CALLER_ARN}",
    "Cognito": {
      "Region": "${AWS_COGNITO_REGION}",
      "UserPoolId": "${AWS_COGNITO_USER_POOL_ID}",
      "ClientId": "${AWS_COGNITO_CLIENT_ID}",
      "ClientSecret": "${AWS_COGNITO_CLIENT_SECRET}",
      "AdminGroupName": "ADMIN"
    },
    "S3": {
      "Bucket": "${AWS_S3_BUCKET}"
    }
  },
  "App": {
    "Admin": {
      "FullName": "${FullName}",
      "Email": "${Emaill}",
      "Password": "${Password}"
    }
  },
  "Upload": {
    "Manuscript": {
      "MaxFileSizeBytes": 26214400,
      "DownloadUrlExpirationMinutes": 10
    }
  },
  "Nougat": {
    "BaseUrl": "http://localhost:8001",
    "TimeoutMinutes": 30
  },
  "Grobid": {
    "BaseUrl": "http://localhost:8070",
    "TimeoutMinutes": 10
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "PaperUploadedTopic": "ripqms.paper-uploaded.v1",
    "OutboxPublisherIntervalSeconds": 5,
    "ConsumerPollTimeoutMs": 1000,
    "OcrConsumerGroupId": "ripqms-paper-ocr",
    "MetadataConsumerGroupId": "ripqms-paper-metadata"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "PublicationQualitySystem": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Information",
      "Microsoft.AspNetCore.Authorization": "Information",
      "Microsoft.AspNetCore.Routing": "Information"
    }
  },
  "AllowedHosts": "*"
}
